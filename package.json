{
  "name": "Tursiops",
  "displayName": "Tursiops",
  "description": "Tursiops is a VS Code extension that works alongside coding agents to provide persistent, file-specific memory and context. It captures agent commands and work summaries, stores context per file, filters relevant information, updates memory as code evolves, and offers a project-aware chat interface.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tursiops",
          "title": "Tursiops",
          "icon": "icons/tursiops.svg"
        }
      ]
    },
    "views": {
      "tursiops": [
        {
          "type": "webview",
          "id": "tursiops.sidebarView",
          "name": "Tursiops"
        }
      ]
    },
    "commands": [
      {
        "command": "Tursiops.explainFile",
        "title": "Tursiops: Explain Current File"
      },
      {
        "command": "Tursiops.showMemory",
        "title": "Tursiops: Show File Memory"
      },
      {
        "command": "Tursiops.clearFileMemory",
        "title": "Tursiops: Clear File Memory"
      },
      {
        "command": "Tursiops.askForChange",
        "title": "Tursiops: Ask for Change"
      },
      {
        "command": "Tursiops.reviewChange",
        "title": "Tursiops: Review Pending Change"
      },
      {
        "command": "Tursiops.setGeminiKey",
        "title": "Tursiops: Set Gemini API Key"
      },
      {
        "command": "Tursiops.clearGeminiKey",
        "title": "Tursiops: Clear Gemini API Key"
      },
      {
        "command": "Tursiops.openMemoryPanel",
        "title": "Tursiops: Open Memory Panel"
      },
      {
        "command": "Tursiops.openAskPanel",
        "title": "Tursiops: Open Ask Panel"
      },
      {
        "command": "tursiops.openSidebar",
        "title": "Tursiops: Show Sidebar"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "Tursiops.openMemoryPanel",
          "when": "view == tursiops.sidebarView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "Tursiops.askForChange",
          "when": "editorIsOpen",
          "group": "tursiops"
        },
        {
          "command": "Tursiops.explainFile",
          "when": "editorIsOpen",
          "group": "tursiops"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6"
  }
}
